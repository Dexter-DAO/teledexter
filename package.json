{
  "name": "teledexter",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/broker/main.ts",
    "start": "node dist/broker/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/helpers/realTmpdir.ts --test tests/**/*.test.ts",
    "calls": "node scripts/calls.mjs",
    "broker": "node --import tsx scripts/broker.mts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@openai/agents": "^0.11.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "openai": "7.15.0",
    "twilio": "^5.12.2",
    "ws": "^8.21.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "private": true,
  "description": "Phone line to your own Dexter agent: Twilio voice calls run on OpenAI GPT-Live, with account work delegated to Primary Dexter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dexter-DAO/teledexter.git"
  },
  "engines": {
    "node": ">=22"
  }
}
