# Teledexter broker configuration. Copy to .env, or point BROKER_ENV_FILE at a file.

# --- Required ---
BROKER_PUBLIC_ORIGIN=https://broker.example.com
BROKER_STATE_DIR=/absolute/path/outside/the/checkout
# At least 32 characters.
BROKER_CONTROL_TOKEN=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Plain HTTP is accepted only for a loopback address.
DEXTER_API_URL=http://127.0.0.1:3033
# At least 32 characters; shared with the Dexter API.
PHONE_SERVICE_SECRET=

# --- Optional ---
# BROKER_ENV_FILE=.env
BROKER_HOST=127.0.0.1
BROKER_PORT=3213
BROKER_LIVE_MODEL=gpt-live-1
BROKER_LIVE_VOICE=marin
BROKER_MAX_CALL_SECONDS=1800
# Comma-separated E.164 numbers that operator and callback calls may dial.
BROKER_ALLOWED_TO=
# Reported by GET /broker/health.
# BROKER_REVISION=development

# Same-call incoming attachment and the phone-setup voice. Empty selects the
# press-1 callback offer. Needs a loopback API origin and the signing secret below.
BROKER_VERIFICATION_SETUP_MODEL=

# Calls from saved watches and notifications. Loopback HTTP origin of the Dexter API.
BROKER_HARK_API_URL=
# At least 32 characters; shared with the Dexter API.
HARK_PHONE_CALLBACK_SIGNING_SECRET=
# Authenticates the notification producer on POST /internal/outbound-alerts.
DEXTER_INTERNAL_TOKEN=
# Read only to check that HARK_PHONE_CALLBACK_SIGNING_SECRET is a different key.
# OUTBOUND_ALERT_SIGNING_SECRET=

# --- SMS (off unless a DEXTER_SMS_* variable is set) ---
# DEXTER_SMS_STATE_PATH=/absolute/path/outside/the/checkout/sms.json
# DEXTER_SMS_INTERNAL_SECRET=
# DEXTER_PHONE_PUBLIC_URL=https://broker.example.com
# TWILIO_VERIFY_SID=
# TWILIO_VERIFY_ACCOUNT_SID=
# TWILIO_VERIFY_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# DEXTER_SMS_ENROLLMENT_ENABLED=false
# DEXTER_SMS_SEND_ENABLED=false
# DEXTER_SMS_CAMPAIGN_APPROVED=false
# DEXTER_SMS_ADVANCED_OPT_OUT_CONFIGURED=false
# DEXTER_SMS_CONSENT_RETENTION_DAYS=1461
# DEXTER_SMS_MESSAGE_RETENTION_DAYS=90
# TWILIO_VALIDATE_WEBHOOKS=true
