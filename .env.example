# Local broker configuration. Keep credentials in your environment or .env.
BROKER_PORT=3213
BROKER_HOST=127.0.0.1
BROKER_PUBLIC_ORIGIN=https://phone.dexter.cash
BROKER_STATE_DIR=
BROKER_CONTROL_TOKEN=
OPENAI_API_KEY=
BROKER_LIVE_MODEL=gpt-live-1
BROKER_LIVE_VOICE=marin
BROKER_MAX_CALL_SECONDS=1800
BROKER_ALLOWED_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Same-host deployment: stable Nginx listener follows the selected API release.
DEXTER_API_URL=http://127.0.0.1:3033
PHONE_SERVICE_SECRET=
# Set to http://127.0.0.1:3033 when enabling saved Hark delivery resolution.
BROKER_HARK_API_URL=
# Reuse the API/producer current raw token when Hark is enabled; coordinate rotation.
DEXTER_INTERNAL_TOKEN=
# Reuse the API's existing Hark callback signing secret; do not create a second key.
HARK_PHONE_CALLBACK_SIGNING_SECRET=

# Selected at the coordinated Phone release; empty preserves existing startup.
# Uses the existing local API origin and independent callback signing secret above.
BROKER_VERIFICATION_SETUP_MODEL=
